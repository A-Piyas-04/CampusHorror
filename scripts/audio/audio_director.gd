extends Node

## Autoload `AudioDirector` (roadmap I3): the zone's ambience bed and acoustics.
## - Ambience: two players on the Ambience bus crossfade (CROSSFADE s) when a zone with another bed is entered.
## - Acoustics: the World bus's reverb (footsteps and world sounds) eases to the zone profile's values.
## - Ducking: during a zone travel fade the Ambience and World buses dip by DUCK_DB.
## - One-shots: `play_ui(id)` (UI bus) and `play_at(id, position)` (World bus, positional) from the SFX table.
## - Tension (composure, roadmap J6): `set_tension(0..1)` fades in a heartbeat and breathing loop and a low drone.
## Bus layout: data/audio/default_bus_layout.tres.
## Without an audio device (the Dummy driver: headless tests) nothing is actually played, because the dummy driver
## never mixes, so playbacks would never be released; the intended state is still tracked for tests.

const CROSSFADE := 1.5
const SILENT_DB := -60.0
const DUCK_DB := -10.0
const REVERB_EASE := 1.0
const DUCKED_BUSES: Array[StringName] = [&"Ambience", &"World"]
const SFX_DIR := "res://assets/audio/sfx/"
## id -> file under assets/audio/sfx/ (generated by assets/source/audio/generate_sfx.py unless credited otherwise).
const SFX := {
	&"keypad_beep": "ui/keypad_beep.wav", &"keypad_ok": "ui/keypad_ok.wav", &"keypad_bad": "ui/keypad_bad.wav",
	&"paper": "ui/paper.wav", &"pickup": "ui/pickup.wav", &"menu_move": "ui/menu_move.wav",
	&"door_open": "world/door_open.wav", &"door_locked": "world/door_locked.wav", &"chain_rattle": "world/chain_rattle.wav",
	&"lantern_on": "world/lantern_on.wav", &"lantern_off": "world/lantern_off.wav",
	&"breaker_clunk": "world/breaker_clunk.wav", &"power_hum_up": "world/power_hum_up.wav",
	&"guard_groan": "world/guard_groan.wav", &"guard_shriek": "world/guard_shriek.wav",
	&"guard_step": "world/guard_step.wav", &"crow_flap": "world/crow_flap.wav", &"metal_bang": "world/metal_bang.wav",
	&"stinger": "world/stinger.wav", &"hatch_open": "world/hatch_open.wav", &"glass_tap": "world/glass_tap.wav",
}
const TENSION_LOOPS := {&"heartbeat": "tension/heartbeat.wav", &"breath": "tension/breath.wav",
	&"drone": "tension/drone.wav"}

var _players: Array[AudioStreamPlayer] = []
var _active := 0
var _reverb: AudioEffectReverb
var _bus_base_db := {}
var _tweens := {}
var _intended: Array[AudioStream] = [null, null]
var _can_play := true
var _sfx_cache := {}
var _tension_players := {}
var tension := 0.0
## Last one-shot requested (tests read this; the Dummy driver plays nothing).
var last_sfx: StringName = &""


func _ready() -> void:
	_can_play = AudioServer.get_driver_name() != "Dummy"
	for i in 2:
		var p := AudioStreamPlayer.new()
		p.name = "Ambience%d" % i
		p.bus = &"Ambience"
		p.volume_db = SILENT_DB
		add_child(p)
		_players.append(p)
	var world := AudioServer.get_bus_index(&"World")
	if world != -1:
		for e in AudioServer.get_bus_effect_count(world):
			var fx := AudioServer.get_bus_effect(world, e)
			if fx is AudioEffectReverb:
				_reverb = fx
	for bus in DUCKED_BUSES:
		var idx := AudioServer.get_bus_index(bus)
		_bus_base_db[bus] = AudioServer.get_bus_volume_db(idx) if idx != -1 else 0.0
	for id: StringName in TENSION_LOOPS:
		var tp := AudioStreamPlayer.new()
		tp.name = "Tension_%s" % id
		tp.bus = &"Ambience"
		tp.volume_db = SILENT_DB
		add_child(tp)
		_tension_players[id] = tp


## Looping beds would otherwise still hold their stream and playback when the engine shuts down (reported as
## leaked AudioStreamWAV / AudioStreamPlaybackWAV instances at exit).
func _exit_tree() -> void:
	for t in _tweens.values():
		if (t as Tween).is_valid():
			(t as Tween).kill()
	_tweens.clear()
	for p in _players:
		p.stop()
		p.stream = null
	for tp: AudioStreamPlayer in _tension_players.values():
		tp.stop()
		tp.stream = null
	_intended = [null, null]
	_sfx_cache.clear()


## Called by Main on every zone entry.
func apply_profile(profile: ZoneProfile) -> void:
	_set_ambience(profile.ambience, profile.ambience_volume_db)
	if _reverb != null:
		_tween_to(&"reverb", _reverb, {"room_size": profile.reverb_room_size, "damping": profile.reverb_damping,
			"wet": profile.reverb_wet}, REVERB_EASE)


## The player's own level for a bus (Settings): ducking dips below it and comes back to it.
func set_bus_base(bus: StringName, db: float) -> void:
	if _bus_base_db.has(bus):
		_bus_base_db[bus] = db


## Dips (true) or restores (false) the Ambience and World buses over `seconds`.
func duck(on: bool, seconds: float) -> void:
	for bus in DUCKED_BUSES:
		var idx := AudioServer.get_bus_index(bus)
		if idx == -1:
			continue
		var target: float = _bus_base_db[bus] + (DUCK_DB if on else 0.0)
		var key := StringName("bus_%s" % bus)
		if _tweens.has(key) and (_tweens[key] as Tween).is_valid():
			(_tweens[key] as Tween).kill()
		var t := create_tween()
		t.tween_method(func(db: float) -> void: AudioServer.set_bus_volume_db(idx, db),
			AudioServer.get_bus_volume_db(idx), target, maxf(seconds, 0.01))
		_tweens[key] = t


## The ambience bed currently playing (or fading in), or null.
func get_ambience() -> AudioStream:
	return _intended[_active]


## False without an audio device (Dummy driver): sounds are tracked but not played.
func can_play() -> bool:
	return _can_play


func get_reverb() -> AudioEffectReverb:
	return _reverb


func _set_ambience(stream: AudioStream, volume_db: float) -> void:
	var current := _players[_active]
	if stream != null and _intended[_active] == stream:
		_fade(current, volume_db, CROSSFADE, false)
		return
	_fade(current, SILENT_DB, CROSSFADE, true)
	_intended[_active] = null
	if stream == null:
		return
	_active = 1 - _active
	var next := _players[_active]
	_intended[_active] = stream
	next.volume_db = SILENT_DB
	if _can_play:
		next.stream = _looping(stream)
		next.play()
	_fade(next, volume_db, CROSSFADE, false)


func _fade(p: AudioStreamPlayer, db: float, seconds: float, stop_after: bool) -> void:
	var key := StringName("player_%s" % p.name)
	if _tweens.has(key) and (_tweens[key] as Tween).is_valid():
		(_tweens[key] as Tween).kill()
	var t := create_tween()
	t.tween_property(p, "volume_db", db, seconds)
	if stop_after:
		t.tween_callback(p.stop)
	_tweens[key] = t


func _tween_to(key: StringName, target: Object, values: Dictionary, seconds: float) -> void:
	if _tweens.has(key) and (_tweens[key] as Tween).is_valid():
		(_tweens[key] as Tween).kill()
	var t := create_tween().set_parallel(true)
	for prop: String in values:
		t.tween_property(target, prop, values[prop], seconds)
	_tweens[key] = t


## Ambience beds must loop. Generated WAVs carry their loop in a `smpl` chunk; this is the safety net.
func _looping(stream: AudioStream) -> AudioStream:
	var wav := stream as AudioStreamWAV
	if wav != null and wav.loop_mode == AudioStreamWAV.LOOP_DISABLED:
		push_warning("[AUDIO] ambience %s has no loop points; looping the whole file." % stream.resource_path)
	return stream


# --- One-shots ----------------------------------------------------------------------------------------------

func _sfx(id: StringName) -> AudioStream:
	if _sfx_cache.has(id):
		return _sfx_cache[id]
	var path: String = SFX_DIR + String(SFX.get(id, TENSION_LOOPS.get(id, "")))
	var stream: AudioStream = load(path) as AudioStream if ResourceLoader.exists(path) else null
	_sfx_cache[id] = stream
	return stream


## A non-positional sound on the UI bus.
func play_ui(id: StringName, volume_db: float = 0.0) -> void:
	last_sfx = id
	var stream := _sfx(id)
	if stream == null or not _can_play:
		return
	var p := AudioStreamPlayer.new()
	p.bus = &"UI"
	p.stream = stream
	p.volume_db = volume_db
	p.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(p)
	p.finished.connect(p.queue_free)
	p.play()


## A positional sound in the world (World bus: it gets the zone's reverb).
func play_at(id: StringName, world_position: Vector2, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	last_sfx = id
	var stream := _sfx(id)
	if stream == null or not _can_play:
		return
	var p := AudioStreamPlayer2D.new()
	p.bus = &"World"
	p.stream = stream
	p.volume_db = volume_db
	p.pitch_scale = pitch
	p.max_distance = 1400.0
	p.attenuation = 1.6
	var parent: Node = get_tree().current_scene if get_tree().current_scene != null else self
	parent.add_child(p)
	p.global_position = world_position
	p.finished.connect(p.queue_free)
	p.play()


# --- Tension (composure) ------------------------------------------------------------------------------------

## Back to the title screen: no ambience, no tension.
func silence() -> void:
	set_tension(0.0)
	_set_ambience(null, SILENT_DB)


## 0 = calm, 1 = terror. Heartbeat from 0.25, breathing from 0.5, a low drone throughout; eased per frame.
func set_tension(value: float) -> void:
	tension = clampf(value, 0.0, 1.0)


func _process(delta: float) -> void:
	if _tension_players.is_empty():
		return
	var targets := {&"drone": remap(tension, 0.1, 1.0, -30.0, -8.0) if tension > 0.1 else SILENT_DB,
		&"heartbeat": remap(tension, 0.25, 1.0, -24.0, 0.0) if tension > 0.25 else SILENT_DB,
		&"breath": remap(tension, 0.5, 1.0, -22.0, -4.0) if tension > 0.5 else SILENT_DB}
	for id: StringName in _tension_players:
		var tp: AudioStreamPlayer = _tension_players[id]
		var want: float = targets[id]
		tp.volume_db = move_toward(tp.volume_db, want, delta * 30.0)
		if id == &"heartbeat":
			tp.pitch_scale = 0.85 + tension * 0.45
		if want > SILENT_DB + 1.0 and not tp.playing and _can_play:
			if tp.stream == null:
				tp.stream = _sfx(id)
			if tp.stream != null:
				tp.play()
		elif want <= SILENT_DB + 1.0 and tp.playing and tp.volume_db <= SILENT_DB + 1.0:
			tp.stop()
