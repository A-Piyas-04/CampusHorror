[node name="Logbook" parent="Objects/Story" instance=ExtResource("11_r")]
position = Vector2(24, -57.6128)
note_id = "security_logbook"
title = "Security logbook, Main Gate"
body = "22:50  Canteen closed. Two students still in CDS. Let them be, exams.\n\n23:04  Power gone, whole campus. Generator in the hall plant room won't start from here.\n\n23:15  Somebody has CHAINED THE MAIN GATE FROM THE OUTSIDE. Called the office. Phone dead.\n\n23:40  Karim from maintenance came running from the hall. Says the plant room hatch is open and \"it is lit up underneath\". He has the new breaker code. He went to hide in the TT room.\n\n00:10  Karim is not Karim. He writes numbers on the walls. In the dark they shine.\n\n00:25  i went out under the lamp. the light is so warm. it wants the light. i want"
verb = "Read"
requires_light = true

