[node name="DirectorLog" parent="Objects/Story" instance=ExtResource("10_r")]
position = Vector2(-80, -90.5344)
note_id = "director_log"
title = "Director's log, Site 7"
body = "1984. The tunnel crew broke into a cavity under the workshops full of soft green light. Organism 7: one colony, kilometres of it, feeding on light and on current.\n\n1991. The University agreed to keep it fed from the campus grid. In return, the research. In return, silence.\n\n2026. It takes more every year. Tonight it took everything: the whole campus went dark at 11:04.\n\nThe feed routing is on the switchboard. Staff card only. If the feed is cut, God help whoever is holding a light."
requires_light = true

[node name="Switchboard" parent="Objects/Story" instance=ExtResource("11_r")]
position = Vector2(80, -147.1184)
verb = "Route"
object_name = "Feed routing"
message = "You swipe the card. One by one you throw the breakers from ORGANISM FEED to LIFT B2. Far below, something shifts in the dark, and every light on B1 dims."
sets_flag = "b2_lift_powered"
requires_flag = "has_facility_card"
not_ready_message = "The switchboard is locked behind a card reader. STAFF CARD ONLY."

