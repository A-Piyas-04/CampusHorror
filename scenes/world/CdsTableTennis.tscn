position = Vector2(176, -67.9008)
note_id = "karim_note"
title = "A torn page"
body = "If you're reading this by lamplight, PUT THE LIGHT OUT and look at the wall.\n\nThe numbers are the hall breaker code. I wrote them the only way it can't read: in its own light.\n\nIt can't see in the dark. In the dark you can see IT.\n\n- K."
verb = "Read"
requires_light = true

