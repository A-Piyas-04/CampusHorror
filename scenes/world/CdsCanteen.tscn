requires_light = false

[node name="Notice" parent="Objects/Story" instance=ExtResource("19_r")]
position = Vector2(214.4, -259.2576)
note_id = "canteen_notice"
title = "Notice board"
body = "NOTICE: CDS block\n\nDuring the exam period the canteen closes at 10:30 pm. Students must leave the CDS block by 11 pm.\n\nLOAD-SHEDDING: hurricane lanterns are kept on the serving counter. Return them after use.\n\nThe indoor games hall is CLOSED for maintenance. Master key with the security office at the Main Gate.\n\n(Someone has written underneath, in pen: \"the hall floor is warm. why is the hall floor warm\")"
verb = "Read"
requires_light = true

