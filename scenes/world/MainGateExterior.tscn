[node name="Ground" type="Node2D" parent="."]
editor_description = "Zone ground (z -10, not Y-sorted, so children draw in tree order: Tiles, EdgeStrips, Markings). Tiles: production campus_ground TileMapLayer, grid on world multiples of 64 px (grass 0, worn grass 1, walkway 2, asphalt 3); paint whole cells here. EdgeStrips: one Polygon2D per off-grid remainder of an original surface (exact blockout boundaries, no snapping), same production PNG, texture_repeat Enabled, no UV, at the origin so the texture stays in phase with the tiles. Markings: placeholder field/road lines. See Docs/CAMPUS_MAP.md (How to edit the map)."
z_index = -10

[node name="Tiles" type="TileMapLayer" parent="Ground"]
editor_description = "Production ground (campus_ground TileSet). Whole cells only; partial cells along off-grid surface edges stay grass and are covered by EdgeStrips."
