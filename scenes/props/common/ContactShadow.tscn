editor_description = "Soft, non-directional ground-contact shadow (64 x 64 px radial fade at scale 1). Add it as a child of a standing prop instance, at the prop's footprint origin, and size it with `scale` (wide and flat, roughly the footprint plus a margin). z_index -9 keeps it above the ground (-10) and below every Y-sorted object (0). No collision. Shadows are never baked into the rendered PNGs (Docs/CONVENTIONS.md §13)."
z_index = -9
texture = SubResource("GradientTexture2D_shadow")
