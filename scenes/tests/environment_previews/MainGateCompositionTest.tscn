[node name="MainGateCompositionTest" type="Node2D"]
editor_description = "TEMPORARY Milestone G visual-composition test (not the final Main Gate, not a zone, not reachable in game). A small slice of main_gate_exterior around the Main Gate: west palm path start, gate plaza, gate gap in the red-brick south boundary wall, gate trees, start of the south tree row, sidewalk and road. Local origin = gate centre on the south wall line; local = blockout world - (-1390, 1400). Positions from the blockout are approximate; hedge, benches, lamps, worn desire line and the pier gate gap are composition choices. The real gate (arch, roof, side pavilion) is NOT built. Every prop is a separately movable instance; its ContactShadow child moves with it."
y_sort_enabled = true
script = ExtResource("1_check")

